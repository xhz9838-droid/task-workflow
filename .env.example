# 环境变量模板（复制为 .env，填写实际值；.env 已 gitignored）
# 禁止把真实凭据提交到 Git

# ── 工作流根（本仓库绝对路径） ──
# 可选：工作流根统一由 scripts/_home.py 解析（环境变量 → ~/.claude/zentao-dev-workflow.json
# → 安装记录 → 开发源 → 向上探测）。此处声明的值必须与解析结果一致，否则明确报错。
WORKFLOW_HOME=D:/WorkSpace/task-workflow

# ── Jenkins（可选；不用 CI 则留空并把 integrations.ci 设为 none） ──
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ── ZenTao（可选；不用任务系统则留空） ──
# ZenTao 凭据仍在 ~/.claude/skills/zentao/_shared/config.json，这里只可覆盖路径
ZENTAO_SKILL_DIR=
ZENTAO_CONFIG=
ZENTAO_MANAGE=
ZENTAO_USER=

# ── CC Connect / 钉钉（可选） ──
CC_CONNECT_DATA_DIR=
# HITL：cc-connect Management API token（可选；留空则自动读取 ~/.cc-connect/config.toml）
CC_MGMT_TOKEN=

# ── 项目路径（按项目配置中的 ${VAR} 填写） ──
JEEBOOTX_ROOT=D:/WorkSpace/jeebootx
JEEBOOTX_SANITATION=D:/WorkSpace/jeebootx/jeebootx-sanitation
JEEBOOTX_UPMS=D:/WorkSpace/jeebootx/jeebootx
JEEBOOTX_WEB=D:/WorkSpace/jeebootx/jeebootx-ui
JEEBOOTX_APP=D:/WorkSpace/jeebootx/jeebootx-app

# ── 人员 ──
USER_ID=
USER_DISPLAY_NAME=
