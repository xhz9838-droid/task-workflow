# zentao-dev-workflow 本地敏感/运行时文件（禁止提交）

# 机器级凭据
.env
.env.*
!.env.example

# 实际项目/人员配置（各人本地从 .example 复制，不进公司仓库）
config/projects/*.yaml
!config/projects/*.example.yaml
config/users/*.yaml
!config/users/*.example.yaml
# 本地适配器覆盖配置（各人路径/凭据）
config/adapters/*.local.yaml
!config/adapters/*.local.example.yaml

# 任务执行状态（真实任务数据，不入库）
execution/

# agent-manager 运行时
agent-manager/logs/
*.db

# Claude / CC Connect 会话敏感
*.local.json
session.local.json
.cc-connect/

# ZenTao token 缓存（含账号/token，绝不提交）
.zentao_token.json

# IDE / 编辑器
.idea/
.vscode/

# Jenkins 原始日志（只留脱敏摘要）
jenkins/*.console.log
jenkins/raw/

# Python 运行产物
__pycache__/
.pytest_cache/
*.pyc
*.log
