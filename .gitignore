# 凭据与本地配置（禁止入库）
.env
.env.*
!.env.example
*.local.json
.claude/settings.local.json
config.json

# Claude / CC Connect 会话敏感信息
execution/**/session.local.json
.cc-connect/

# Jenkins 原始日志（可能含环境信息，只保留脱敏摘要）
execution/**/jenkins/*.console.log
execution/**/jenkins/raw/

# 运行产物
__pycache__/
*.pyc
*.log
node_modules/
.worktrees/

# 个人实际配置不入库（只提交 example）
config/users/*.yaml
!config/users/*.example.yaml

# IDE / 运行时
.idea/
.claude/scheduled_tasks.lock

# agent-manager 运行数据（状态库/日志不入库）
agent-manager/logs/
agent-manager/**/*.db
agent-manager/**/*.db-wal
agent-manager/**/*.db-shm

# HITL 个人本地配置（userId 等个人身份，不入库）
config/adapters/hitl.local.yaml
config/**/hitl.local.yaml
